# Battery SDK sample-application configuration.
#
# All CONFIG_BATTERY_* option definitions live in app/Kconfig.battery, which
# is ALSO sourced by the Zephyr-module Kconfig (Kconfig.ibattery) — single
# source of truth, so the app and module config trees cannot drift.

rsource "Kconfig.battery"

source "Kconfig.zephyr"
